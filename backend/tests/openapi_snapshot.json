    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CommonErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "CommonErrorEnvelope"
      },
      "ConflictDetails": {
        "properties": {
          "acousticSignal": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acousticsignal",
            "description": "음향신호기 원천 vs 현장 불일치 여부"
          },
          "tactilePaving": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tactilepaving",
            "description": "점자블록 원천 vs 현장 불일치 여부"
          },
          "curbCut": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Curbcut",
            "description": "보도턱낮춤 원천 vs 현장 불일치 여부"
          }
        },
        "type": "object",
        "title": "ConflictDetails"
      },
      "CorridorRequest": {
        "properties": {
          "type": {
            "type": "string",
            "const": "LineString",
            "title": "Type",
            "description": "GeoJSON 형상 타입 (LineString)",
            "default": "LineString"
          },
          "coordinates": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Coordinates",
            "description": "경로 좌표열 [[lon1, lat1], ..., [lonN, latN]] (최소 2개, 최대 500개)"
          },
          "bufferM": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 5.0,
            "title": "Bufferm",
            "description": "경로 회랑 버퍼 폭 (5.0m ~ 100.0m)",
            "default": 30.0
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "description": "최대 반환 개수 (1 ~ 100)",
            "default": 50
          }
        },
        "type": "object",
        "required": [
          "coordinates"
        ],
        "title": "CorridorRequest"
      },
      "CrossingItemResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "횡단보도 고유 식별자 (UUID)"
          },
          "location": {
            "$ref": "#/components/schemas/LocationPoint",
            "description": "횡단보도 대표 위치 좌표"
          },
          "roadName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Roadname",
            "description": "도로명 또는 지번 주소"
          },
          "pedestrianSignal": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pedestriansignal",
            "description": "보행자 신호등 설치 여부 (null/false/true)"
          },
          "acousticSignal": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acousticsignal",
            "description": "시각장애인용 음향신호기 설치 여부 (null/false/true)"
          },
          "tactilePaving": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tactilepaving",
            "description": "점자블록 설치 여부 (null/false/true)"
          },
          "curbCut": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Curbcut",
            "description": "연석 단차/보도 턱낮춤 여부 (null/false/true)"
          },
          "directionBearingDeg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Directionbearingdeg",
            "description": "횡단 진행 방위각 (0~360°)"
          },
          "laneCount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lanecount",
            "description": "횡단 차로 수"
          },
          "greenSeconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Greenseconds",
            "description": "보행 신호 녹색 시간 (초)"
          },
          "redSeconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Redseconds",
            "description": "보행 신호 적색 시간 (초)"
          },
          "source": {
            "$ref": "#/components/schemas/SourceMetadata",
            "description": "원천 데이터 출처 및 메타데이터"
          },
          "verification": {
            "$ref": "#/components/schemas/VerificationMetadata",
            "description": "현장 검증 메타데이터 및 원천 충돌 플래그"
          },
          "rawFacility": {
            "$ref": "#/components/schemas/RawFacility",
            "description": "투영 전 원본 공공데이터 시설값"
          }
        },
        "type": "object",
        "required": [
          "id",
          "location",
          "source",
          "verification",
          "rawFacility"
        ],
        "title": "CrossingItemResponse"
      },
      "CrossingsListResponse": {
        "properties": {
          "dataVersion": {
            "type": "string",
            "title": "Dataversion",
            "description": "데이터셋 배포 버전 (예: kr-crossing-20260908.1)"
          },
          "generatedAt": {
            "type": "string",
            "title": "Generatedat",
            "description": "응답 생성 시각 (ISO 8601)"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CrossingItemResponse"
            },
            "type": "array",
            "title": "Items",
            "description": "조회된 횡단보도 목록"
          }
        },
        "type": "object",
        "required": [
          "dataVersion",
          "generatedAt",
          "items"
        ],
        "title": "CrossingsListResponse"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "messageKey": {
            "type": "string",
            "title": "Messagekey"
          },
          "correlationId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correlationid"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "messageKey"
        ],
        "title": "ErrorDetail"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LocationPoint": {
        "properties": {
          "lat": {
            "type": "number",
