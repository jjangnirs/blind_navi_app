# Safe Cross KR 환경 변수 템플릿
# 주의: 본 파일에 실제 API 키, 비밀번호, 시크릿을 절대 커밋하지 마십시오.
# 로컬 개발 시에는 이 파일을 복사하여 .env 파일을 생성하고 값을 입력하십시오.

# 데이터베이스 (PostgreSQL / PostGIS)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=

# 백엔드 보안 및 서버 설정
ENVIRONMENT=
SECRET_KEY=
BACKEND_PORT=

# 외부 API (TMAP 보행자 경로 API 등 - 서버에서만 사용)
TMAP_APP_KEY=
ROUTER_PROVIDER=fake # "fake" 또는 "tmap"


# 실시간 보행신호 연계 (승인된 공식 공급자 연계 시)
SIGNAL_STATUS_PROVIDER_URL=
SIGNAL_STATUS_API_KEY=
